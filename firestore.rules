rules_version = '2';

/*
 * Firestore-rules voor het eigen project van de trainingsapp (trainingsapp-c87cf).
 *
 * Model: geen accounts, wel een (anonieme) auth-token. De niet-te-raden code in
 * het pad is het gedeelde geheim tussen de toestellen van één huishouden. Wie de
 * code niet heeft, kan het pad niet noemen en komt er dus niet bij; zonder token
 * komt niemand ergens.
 *
 * Per gebruiker één document, zodat twee toestellen die tegelijk loggen elkaar
 * niet overschrijven.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    match /trainingsapp/{code} {
      allow read, write: if request.auth != null && geldigeCode(code);

      match /gebruikers/{gebruiker} {
        allow read, write: if request.auth != null && geldigeCode(code);
      }
    }

    // Alleen codes in het formaat dat de app zelf uitgeeft: 16 hex-tekens.
    // Houdt losse pogingen op korte, raadbare paden buiten de deur.
    function geldigeCode(code) {
      return code is string && code.matches('^[0-9a-f]{16}$');
    }

    // De rest van het project: dicht.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
