# trainingsapp/server — instellingen van de review-endpoint
#
# Kopieer dit bestand naar `.env` en vul de sleutel in. `.env` staat in .gitignore en
# hoort daar te blijven: dat dit bestand bestaat is de reden dat de app niet meer op
# GitHub Pages staat.
#
#   cp .env.example .env && nano .env

# VERPLICHT — je Anthropic-API-sleutel.
# Maak er een aparte aan met het label "trainingsapp", net als bij de nieuws-poller en
# ~/trainingsreview: los in te trekken, en je ziet per project wat het kost.
ANTHROPIC_API_KEY=

# Welk model de review schrijft. Claude Opus 5 is de standaard: één aanroep per profiel
# per dag over een samenvatting van een paar duizend tokens, en het oordeel ís hier het
# product. Goedkoper kan met claude-sonnet-5.
REVIEW_MODEL=claude-opus-5

# Hoeveel denkwerk de review krijgt: low | medium | high | xhigh | max.
REVIEW_EFFORT=high

# Bovengrens aan het antwoord. Ruim: het denkwerk telt hierin mee.
REVIEW_MAX_TOKENS=8000

# Hoeveel weken er in de samenvatting gaan. 8 is twee deloadcycli.
REVIEW_WEKEN=8

# Waar hij luistert. Standaard alleen op de loopback; docker-compose zet dit op 0.0.0.0
# omdat nginx daar uit een andere container komt (die container publiceert geen poort).
REVIEW_HOST=127.0.0.1
REVIEW_PORT=8098

# Waar de dagcache staat: één regel per profiel, met het advies van vandaag.
REVIEW_CACHE_FILE=data/reviews.json

# Hoe lang een aanroep mag duren voordat hij opgeeft, in milliseconden.
REVIEW_TIMEOUT_MS=180000
